{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "description": "Family-focused air-quality planner for Indian cities — PromptWars Challenge 06",
  "license": "MIT",
  "author": "Urban Air Quality Assistant Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/salonithebest/urban-air-quality-assistant.git"
  },
  "keywords": [
    "cpcb-aqi",
    "air-quality",
    "gemini-api",
    "google-promptwars",
    "carbon-reduction",
    "typescript"
  ],
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm run test --workspace=server",
    "test:coverage": "npm run test:coverage --workspace=server",
    "lint": "tsc --noEmit --project client && tsc --noEmit --project server"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
